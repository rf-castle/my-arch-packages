@@ -0,0 +1,31 @@
+#include <stdlib.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/tree/arrange.h"
+
+// tabs_opacity <front> <hidden> <bottom>
+struct cmd_results *cmd_tabs_opacity(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "tabs_opacity", EXPECTED_EQUAL_TO, 3))) {
+		return error;
+	}
+
+	float values[3];
+	for (int i = 0; i < 3; ++i) {
+		char *err;
+		values[i] = strtof(argv[i], &err);
+		if (*err || values[i] < 0 || values[i] > 1) {
+			return cmd_results_new(CMD_INVALID,
+					"Expected: tabs_opacity <front> <hidden> <bottom> (each 0..1)");
+		}
+	}
+	for (int i = 0; i < 3; ++i) {
+		config->tabs_opacity[i] = values[i];
+	}
+
+	if (!config->reading) {
+		arrange_root();
+	}
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
