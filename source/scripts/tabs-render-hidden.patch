+	// フォーカス順（新しい順）。ipc の "focus" 配列と同じ取り方
+	int count = 0;
+	struct sway_seat *seat = input_manager_current_seat();
+	struct sway_seat_node *current;
+	wl_list_for_each(current, &seat->focus_stack, link) {
+		if (count == n) {
+			break;
+		}
+		struct sway_node *node = current->node;
+		if (node->type == N_CONTAINER &&
+				list_find(children, node->sway_container) != -1) {
+			order[count++] = node->sway_container;
+		}
+	}
+	// focus_stack に無い子は並び順で後ろに足す（通常は起きない）
+	for (int i = 0; i < n && count < n; i++) {
+		struct sway_container *child = children->items[i];
+		bool found = false;
+		for (int j = 0; j < count; j++) {
+			if (order[j] == child) {
+				found = true;
+				break;
+			}
+		}
+		if (!found) {
+			order[count++] = child;
+		}
+	}
+
+	for (int i = 0; i < n; i++) {
+		struct sway_container *child = order[i];
+		enum sway_tab_role role;
+		if (!child->view) {
+			role = TAB_ROLE_NONE;
+		} else if (i == n - 1) {
+			role = TAB_ROLE_BOTTOM;
+		} else if (child == active) {
+			role = TAB_ROLE_FRONT;
+		} else {
+			role = TAB_ROLE_HIDDEN;
+		}
+		set_tab_role(child, role);
+	}
+
+	if (config->tabs_render_hidden) {
+		for (int i = n - 1; i >= 0; i--) {
+			wlr_scene_node_raise_to_top(&order[i]->scene_tree->node);
+		}
+		if (active) {
+			wlr_scene_node_raise_to_top(&active->scene_tree->node);
+		}
+	}
+	free(order);
+}
