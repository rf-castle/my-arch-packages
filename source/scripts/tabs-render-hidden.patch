diff --git a/sway/commands/tab_opacity.c b/sway/commands/tab_opacity.c
new file mode 100644
index 0000000..f05e3ea
--- /dev/null
+++ b/sway/commands/tab_opacity.c
@@ -0,0 +1,51 @@
+#include <stdlib.h>
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/output.h"
+#include "sway/tree/container.h"
+
+// tab_opacity <front|hidden|bottom|all> <0..1>|reset
+struct cmd_results *cmd_tab_opacity(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "tab_opacity", EXPECTED_EQUAL_TO, 2))) {
+		return error;
+	}
+
+	struct sway_container *con = config->handler_context.container;
+	if (con == NULL) {
+		return cmd_results_new(CMD_FAILURE, "No current container");
+	}
+
+	int first, last;
+	if (!strcasecmp(argv[0], "front")) {
+		first = last = TAB_ROLE_FRONT - 1;
+	} else if (!strcasecmp(argv[0], "hidden")) {
+		first = last = TAB_ROLE_HIDDEN - 1;
+	} else if (!strcasecmp(argv[0], "bottom")) {
+		first = last = TAB_ROLE_BOTTOM - 1;
+	} else if (!strcasecmp(argv[0], "all")) {
+		first = 0;
+		last = TAB_ROLE_COUNT - 1;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+				"Expected: tab_opacity <front|hidden|bottom|all> <0..1>|reset");
+	}
+
+	float val;
+	if (!strcasecmp(argv[1], "reset")) {
+		val = -1.0f;
+	} else {
+		char *err;
+		val = strtof(argv[1], &err);
+		if (*err || val < 0 || val > 1) {
+			return cmd_results_new(CMD_INVALID, "tab_opacity value must be 0..1 or reset");
+		}
+	}
+
+	for (int i = first; i <= last; ++i) {
+		con->tab_opacity[i] = val;
+	}
+	output_configure_scene(NULL, &con->scene_tree->node, 1.0f);
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
