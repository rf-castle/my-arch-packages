diff --git a/sway/commands/tabs_render_hidden.c b/sway/commands/tabs_render_hidden.c
new file mode 100644
index 0000000..36b630c
--- /dev/null
+++ b/sway/commands/tabs_render_hidden.c
@@ -0,0 +1,18 @@
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/tree/arrange.h"
+#include "util.h"
+
+struct cmd_results *cmd_tabs_render_hidden(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "tabs_render_hidden", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+
+	config->tabs_render_hidden = parse_boolean(argv[0], config->tabs_render_hidden);
+	if (!config->reading) {
+		arrange_root();
+	}
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
