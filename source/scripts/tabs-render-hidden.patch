+ * 有効ならフォーカス順に重ねる（一番奥が最背面、表が最前面）。
+ */
+static void arrange_tab_roles(list_t *children, struct sway_container *active) {
+	int n = children->length;
+	if (n == 0) {
+		return;
+	}
+	struct sway_container **order = calloc(n, sizeof(*order));
+	if (!order) {
+		return;
+	}
